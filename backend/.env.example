# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/trustpay
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT Configuration
# Required: generate a unique Base64 secret with: openssl rand -base64 32
JWT_SECRET=
# Token lifetime in milliseconds (minimum 1000)
JWT_EXPIRATION=86400000

# Admin Configuration
# Enable only when creating the first administrator, then disable it again.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
# 12-60 characters, uppercase, lowercase, digit, special character, max 72 UTF-8 bytes
ADMIN_PASSWORD=

# Explicit comma-separated browser origins; required for cross-origin access in prod
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# Server Configuration
SERVER_PORT=8080
LOG_LEVEL=INFO
SHOW_SQL=false
